# CanyonOS passes this file to every container (env_file in .canyon/config/global_controller.yaml).
# Uncomment and fill in the keys you use. Leave a key commented until you have it:
# an empty KEY= line is sent as an empty key and the provider answers 401.
# See .env.example for every supported name.

# Required for the default provider (TRADINGAGENTS_LLM_PROVIDER unset = openai)
# OPENAI_API_KEY=

# Only when TRADINGAGENTS_LLM_PROVIDER selects another provider
#ANTHROPIC_API_KEY=
#GOOGLE_API_KEY=

# Optional data sources
#SEC_EDGAR_USER_AGENT=Your Name your@email.com
#FRED_API_KEY=
#TYPESAFE_API_KEY=
#ALPHA_VANTAGE_API_KEY=
CANYONOS_JWT_SECRET=GLJWda_4-AiyTBGDmyT9rU-Ju34kZmWkKXviz-gWF2o
CANYONOS_REDIS_HOST=host.docker.internal
CANYONOS_REDIS_PORT=6379
CANYONOS_API_IMAGE=ghcr.io/canyoncodecoreai/canyonos-api:0.1.733
CANYONOS_WEB_IMAGE=ghcr.io/canyoncodecoreai/canyonos-web:0.1.733
CANYONOS_WEB_PORT=8081
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_MAX_TOOL_ROUNDS=20

# CanyonOS port: keys every container reads through env_file (.env.example lists them all).
# The default provider (openai) needs OPENAI_API_KEY with a real value; an empty line makes the gateway answer 401.
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#SEC_EDGAR_USER_AGENT=Your Name your@email.com
#FRED_API_KEY=
