# OpenRCA under CanyonOS. Copy the names you need into .env and fill them in.

# Upstream key the CanyonOS LLM gateway uses for OpenAI-compatible calls.
OPENAI_API_KEY=

# Model id sent to the provider when no config.json is present
# (otherwise the "gemini3pro" entry of config.json is used).
OPENRCA_MODEL=

# Optional: OpenAI-compatible upstream for the gateway, i.e. the base_url you
# would put in config.json. Leave unset to use api.openai.com.
# OPENAI_UPSTREAM_BASE=

# Optional: path of the model config file, relative to the repository root.
# API_CONFIG_PATH=config.json
