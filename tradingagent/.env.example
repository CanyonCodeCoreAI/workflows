# Copy to .env and fill in a real value. Loaded by config/global_controller.yaml
# (env_file: .env) and passed to every agent container.

# The only credential this workflow needs. Market data comes from Yahoo
# Finance through yfinance, which needs no key.
#
# Sent through the CanyonOS LLM gateway, which CanyonOS points OPENAI_BASE_URL
# at -- so the caps in config/llms.yaml apply and every call's cost is
# recorded. Leave the line commented until you have a key: an empty KEY= is
# passed through as an empty key, and the provider answers 401.
#OPENAI_API_KEY=

# Which model the reasoning agents call. Defaults to gpt-4o-mini, which is
# small on purpose: one request is at least 14 calls. Whatever you set must
# have a matching model_id in config/llms.yaml, or the gateway refuses the
# call with a 403.
#OPENAI_MODEL=gpt-4o-mini

# A cap on output tokens, off by default. Only set this to rein in a model
# that runs away and trips a timeout: on a reasoning model the cap covers the
# thinking as well as the answer, so too low a value starves the reasoning and
# the call comes back empty.
#MAX_OUTPUT_TOKENS=4000
